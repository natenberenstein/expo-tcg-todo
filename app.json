{
  "expo": {
    "name": "CardQuest Todo",
    "slug": "expo-tcg-todo",
    "version": "1.0.0",
    "orientation": "portrait",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow CardQuest Todo to use the camera for card scanning."
        }
      ]
    ],
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro"
    }
  }
}
